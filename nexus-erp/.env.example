# ─── Banco de dados ──────────────────────────────────────────────────────────
# URL de conexão via pooler (runtime da aplicação) — Supabase Transaction Pooler
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# URL direta (apenas para prisma db push / migrations) — porta 5432
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-here"
# Em desenvolvimento: http://localhost:3000
# Em produção: https://seu-dominio.com (Vercel define automaticamente)
NEXTAUTH_URL="http://localhost:3000"

# ─── SMTP (para 2FA por e-mail) ───────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="seu-email@gmail.com"
SMTP_PASS="sua-senha-de-app"
SMTP_FROM="Nexus ERP <noreply@seudominio.com>"
